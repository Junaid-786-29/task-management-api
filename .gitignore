# ==========================================
# Keystone Task Management System - .gitignore
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert

# ------------------------------------------
# Python & Django
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# Virtual Environments
venv/
env/
ENV/
.venv/
backend/venv/
backend/env/
backend/.venv/
*/venv/
*/env/
*/.venv/

# Django specific
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static_root/
celerybeat-schedule
celerybeat.pid

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
.tox/
.nox/
nosetests.xml
coverage.xml

# ------------------------------------------
# Node / Frontend / JavaScript / TypeScript
# ------------------------------------------
node_modules/
**/node_modules/
frontend/node_modules/
.pnpm-store/
frontend/.pnpm-store/

# Build outputs
frontend/dist/
frontend/build/
dist/
build/
*.dist

# TypeScript Cache
*.tsbuildinfo
next-env.d.ts

# Vite / bundler caches
.cache/
.parcel-cache/
.vite/
.turbo/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Frontend zip archives & logs
*.zip
frontend/*.zip
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache

# ------------------------------------------
# IDEs, Editors & Tooling
# ------------------------------------------
.vscode/
*.code-workspace
.idea/
*.iml
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.#*

# AI Agent / System metadata
.gemini/
.agents/
.manus-logs/
.project-config.json
.webdev/

# ------------------------------------------
